### 2. 创建项目（拿到 projectId，假设为 1）
POST http://localhost:8080/api/projects
Authorization: Bearer eyJhbGciOiJIUzM4NCJ9.eyJzdWIiOiJoZjEyMyIsInJvbGUiOiJVU0VSIiwiaWF0IjoxNzkwMjMwNDIzLCJleHAiOjE3OTAyMzQwMjN9.acMTroKmciJjbJYYMcHCkaBSWoFmEjCsdJIc--r-ujQrUjayq2hjkpkLfPm0Q7jt
Content-Type: application/json

{
  "name": "项目A",
  "description": "测试任务"
}

### 3. 在项目 1 下创建任务
POST http://localhost:8080/api/projects/2/tasks
Authorization: Bearer eyJhbGciOiJIUzM4NCJ9.eyJzdWIiOiJoZjEyMyIsInJvbGUiOiJVU0VSIiwiaWF0IjoxNzkwMjMwNDIzLCJleHAiOjE3OTAyMzQwMjN9.acMTroKmciJjbJYYMcHCkaBSWoFmEjCsdJIc--r-ujQrUjayq2hjkpkLfPm0Q7jt
Content-Type: application/json

{
  "title": "写任务模块",
  "description": "第7周任务模块",
  "priority": 4,
  "dueDate": "2026-10-01T10:00:00"
}

